{% set media = paragraph.field_image.entity %}
{% set image = media ? media.field_media_image.entity : null %}

<section class="fade-up hero-banner">  
  {% if image %}
    <div class="hero-banner-bg"
         style="background-image: url('{{ file_url(image.fileuri) }}');">
    </div>
  {% endif %}

  <div class="hero-banner-overlay"></div>

  <div class="grid-container">
    <div class="grid-x align-middle">
      <div class="cell medium-6 large-5 hero-banner-content">

        {% if content.field_title %}
          <h1>{{ content.field_title }}</h1>
        {% endif %}

        {% if content.field_text %}
          {{ content.field_text }}
        {% endif %}

        {% if content.field_cta %}
            {{ content.field_cta }}
        {% endif %}

      </div>
    </div>
  </div>
</section>